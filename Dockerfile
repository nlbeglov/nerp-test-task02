# базовый образ - конкретная версия Python, НЕ "latest".
# "slim" - облегчённый вариант Debian с Python, без лишних утилит,
# которые нам не нужны в проде (меньше размер образа, меньше поверхность атаки)
FROM python:3.12.3-slim

# рабочая директория внутри контейнера - все дальнейшие команды
# (COPY, RUN, CMD) выполняются относительно неё
WORKDIR /app

# копируем ТОЛЬКО requirements.txt на этом шаге (не весь проект!) -
# это отдельный слой Docker, который кэшируется. Пока requirements.txt
# не меняется, Docker при пересборке не будет заново скачивать
# и ставить пакеты, даже если изменился код в app.py
COPY requirements.txt .

# --no-cache-dir - не сохранять кэш pip внутри образа, экономит место
# в итоговом образе (кэш нужен только на время самой установки)
RUN pip install --no-cache-dir -r requirements.txt

# теперь копируем сам код приложения - если поменяется только он,
# пересоберётся только этот слой и все, что после него
COPY src/ ./src/

# документирует, что приложение слушает порт 8000 (носит информационный
# характер, сам по себе EXPOSE порт не открывает - реальное пробрасывание
# порта делается в docker-compose.yml через "ports:")
EXPOSE 8000

# ARG - переменная, доступная только во время СБОРКИ образа (не во время
# работы контейнера). Через неё GitHub Actions передаст номер сборки/commit,
# чтобы можно было "вморозить" версию прямо в образ на этапе сборки.
# Мы используем этот ARG, чтобы задать значение по умолчанию для ENV ниже.
ARG APP_VERSION=dev

# ENV - переменная окружения, которая будет доступна УЖЕ ВНУТРИ
# запущенного контейнера, и её же читает os.environ.get("APP_VERSION")
# в src/app.py. Обрати внимание: её всё равно можно переопределить
# при запуске контейнера (docker run -e APP_VERSION=... или
# environment: в docker-compose.yml) - ARG только задаёт значение по умолчанию.
ENV APP_VERSION=${APP_VERSION}

# gunicorn - production WSGI-сервер для Flask (см. requirements.txt).
# --bind 0.0.0.0:8000 - слушать все интерфейсы контейнера на порту 8000
# src.app:app - "в пакете src, в файле app.py, взять объект с именем app"
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "src.app:app"]
